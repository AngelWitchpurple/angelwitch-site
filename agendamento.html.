<script>

const cards = document.querySelectorAll(".consulta");

const radios = document.querySelectorAll(
    'input[name="consulta"]'
);

const resumoConsulta =
    document.getElementById("resumoConsulta");

const resumoValor =
    document.getElementById("resumoValor");


radios.forEach(function(radio){

    radio.addEventListener("change",function(){

        cards.forEach(function(card){
            card.classList.remove("selected");
        });

        radio
            .closest(".consulta")
            .classList.add("selected");

        resumoConsulta.textContent = radio.value;

        resumoValor.textContent =
            "R$ " +
            Number(radio.dataset.price)
                .toFixed(2)
                .replace(".", ",");

    });

});


function copiarPix(){

    const pix =
        document
        .getElementById("pix")
        .textContent
        .trim();

    if(
        navigator.clipboard &&
        window.isSecureContext
    ){

        navigator.clipboard
            .writeText(pix)
            .then(function(){

                alert("✨ Chave Pix copiada!");

            })
            .catch(function(){

                alert("Copie manualmente: " + pix);

            });

    }else{

        alert("Copie manualmente: " + pix);

    }

}


function finalizarConsulta(){

    const nome =
        document
        .getElementById("nome")
        .value
        .trim();

    const signo =
        document
        .getElementById("signo")
        .value;

    const pergunta =
        document
        .getElementById("pergunta")
        .value
        .trim();

    const consulta =
        document.querySelector(
            'input[name="consulta"]:checked'
        );


    if(!consulta){

        alert("🔮 Escolha sua consulta primeiro.");
        return;

    }

    if(!nome){

        alert("✨ Digite seu nome.");

        document
        .getElementById("nome")
        .focus();

        return;

    }

    if(!signo){

        alert("🌙 Escolha seu signo.");

        document
        .getElementById("signo")
        .focus();

        return;

    }


    const valor =
        Number(consulta.dataset.price)
        .toFixed(2)
        .replace(".", ",");


    document
        .getElementById("success")
        .classList
        .add("show");


    document
        .getElementById("successText")
        .textContent =
        nome +
        ", sua consulta \"" +
        consulta.value +
        "\" no valor de R$ " +
        valor +
        " foi preparada. ✦";


    /*
      SEU WHATSAPP
      Número: 34 99133-5673
    */

    const whatsapp = "5534991335673";


    const mensagem =
`🔮 ANGEL WITCH — MINHA CONSULTA ✦

Olá! Quero realizar uma consulta na Angel WITCH.

👤 Nome: ${nome}
♈ Signo: ${signo}

🔮 Consulta escolhida:
${consulta.value}

💰 Valor:
R$ ${valor}

🌙 Minha pergunta:
${pergunta || "Não informada"}

💜 Pagamento:
Pix — Maiamisqui@gmail.com`;


    const url =
        "https://wa.me/" +
        whatsapp +
        "?text=" +
        encodeURIComponent(mensagem);


    setTimeout(function(){

        window.location.href = url;

    },1000);

}

</script>

