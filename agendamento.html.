<script>

/* ==============================
   SELEÇÃO DA CONSULTA
============================== */

const cards =
document.querySelectorAll(".consulta");

const radios =
document.querySelectorAll(
'input[name="consulta"]'
);

const resumoConsulta =
document.getElementById("resumoConsulta");

const resumoValor =
document.getElementById("resumoValor");


radios.forEach(radio => {

    radio.addEventListener("change", () => {

        cards.forEach(card => {

            card.classList.remove(
                "selected"
            );

        });

        radio
        .closest(".consulta")
        .classList.add("selected");


        resumoConsulta.textContent =
        radio.value;

        resumoValor.textContent =
        "R$ " +
        Number(
            radio.dataset.price
        )
        .toFixed(2)
        .replace(".", ",");

    });

});


/* ==============================
   COPIAR PIX
============================== */

function copiarPix(){

    const pix =
    document.getElementById("pix")
    .textContent;

    navigator.clipboard
    .writeText(pix);

    alert(
        "✨ Chave Pix copiada!"
    );

}


/* ==============================
   FINALIZAR
============================== */

function finalizarConsulta(){

    const nome =
    document
    .getElementById("nome")
    .value
    .trim();

    const signo =
    document
    .getElementById("signo")
    .value;

    const pergunta =
    document
    .getElementById("pergunta")
    .value
    .trim();

    const consulta =
    document.querySelector(
        'input[name="consulta"]:checked'
    );


    if(!consulta){

        alert(
            "🔮 Escolha sua consulta primeiro."
        );

        return;
    }


    if(!nome){

        alert(
            "✨ Digite seu nome."
        );

        return;
    }


    if(!signo){

        alert(
            "🌙 Escolha seu signo."
        );

        return;
    }


    const valor =
    Number(
        consulta.dataset.price
    )
    .toFixed(2)
    .replace(".", ",");


    document
    .getElementById("success")
    .classList
    .add("show");


    document
    .getElementById("successText")
    .textContent =

    `${nome}, sua consulta "${consulta.value}" no valor de R$ ${valor} foi preparada. ✦`;


    /*
       IMPORTANTE:

       COLOQUE AQUI O NÚMERO
       DO SEU WHATSAPP.

       Formato:
       5511999999999

       Sem +, espaços ou parênteses.
    */

    const whatsapp =
    "COLOQUE_SEU_NUMERO_AQUI";


    const mensagem =

`🔮 ANGEL WITCH — MINHA CONSULTA ✦

Nome: ${nome}
Signo: ${signo}
Consulta: ${consulta.value}
Valor: R$ ${valor}

Pergunta:
${pergunta || "Não informada"}

Pagamento:
Pix — Maiamisqui@gmail.com`;


    /*
       Se você colocar seu número,
       o WhatsApp abrirá automaticamente.
    */

    if(
        whatsapp !==
        "COLOQUE_SEU_NUMERO_AQUI"
    ){

        const url =
        "https://wa.me/" +
        whatsapp +
        "?text=" +
        encodeURIComponent(
            mensagem
        );

        setTimeout(() => {

            window.location.href =
            url;

        },1200);

    }

}

</script>


